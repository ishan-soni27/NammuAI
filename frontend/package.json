{
  "name": "kestrel-bay-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dana's Monday ordering screen for Kestrel Bay Seafood (React + Vite + TypeScript).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "date-fns": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  }
}
