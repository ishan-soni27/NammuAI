# Copy to backend/.env and fill in. backend/.env is gitignored and must never be committed.

# Supabase → Connect → "Session pooler" connection string (IPv4-compatible; the direct
# connection can be IPv6-only and fail from Render or a home network). Either scheme works:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The app rewrites postgresql:// to postgresql+psycopg:// (psycopg 3) automatically.
DATABASE_URL=

# Business "today". Never the system clock (BUILD_PROMPT invariant #1).
AS_OF_DATE=2026-11-16

# Comma-separated list of browser origins allowed to call the API (the Vercel URL in production).
CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# local | production (production hides internal error details from responses)
APP_ENV=local
